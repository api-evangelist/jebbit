{
  "opencollection": "1.0.0",
  "info": {
    "name": "Jebbit Auth Campaigns API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Campaigns",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lists campaigns",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.jebbit.com/api/v1/campaigns",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists campaigns"
        },
        {
          "info": {
            "name": "Retrieves a Campaign",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api2.jebbit.com/api/v1/campaigns/:campaign_id",
            "params": [
              {
                "name": "campaign_id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves a Campaign"
        }
      ]
    }
  ],
  "bundled": true
}